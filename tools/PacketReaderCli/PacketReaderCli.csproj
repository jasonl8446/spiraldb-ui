<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>imview-packet-reader</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The Imview root is a property, not a relative literal: see the root
         `Directory.Build.props` (F1, final-deslop). Defaults to the owner's sibling layout. -->
    <ProjectReference Include="$(ImviewRoot)/src/Imview.PacketReader/Imview.PacketReader.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- D45: the spec snippet omits serialization; the corpus/review JSON format is
         Newtonsoft with the type-name settings below, so Newtonsoft is required here.
         Not transitively available from Imview.PacketReader; pinned to 13.0.3 house-wide. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>