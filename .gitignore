# Local orchestration state (not part of the project)
.omd/
# oh-my-claudecode state and the Phase 7 ledger `.omc/prd.json` (D125: local, never committed)
.omc/

# Application data (Phase 1+: SQLite db, test clone of the SpiralDB fork)
data/

# Dependencies & build output
node_modules/
client/dist/
server/dist/
*.tsbuildinfo

# npm cache is kept workspace-local because the agent sandbox cannot write $HOME (.npmrc)
.npm-cache/

# .NET tooling (kept inside the workspace per plan decision D18)
tools/bin/
tools/.obj/
tools/.artifacts/
tools/.nuget/
# The `ArtifactsPath` `imlight-boot`'s rebuild remedy prints (it is a D18 flag combination, but the
# path is a one-off the harness chose, so it needs its own line). The Imlight build output alone is
# hundreds of MB, and D83 records a falsification break that `git add -A` committed.
tools/.imlight-artifacts/

# Playwright browsers (workspace-local per plan decision D23)
tools/.playwright-browsers/

# Phase 6 live-load harness run directories (D114). The Imlight build copy alone is
# ~866 MB, and D83 records a falsification break that `git add -A` committed.
tools/.imlight-run/
tools/.aurorium-run/
ImlightEmbeddedDatabase/
test-results/
playwright-report/

# Evidence artifacts are committed selectively under docs/evidence/; scratch stays out
*.log
