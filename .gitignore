# Local orchestration state (not part of the project)
.omd/

# Application data (Phase 1+: SQLite db, test clone of the SpiralDB fork)
data/

# Dependencies & build output
node_modules/
client/dist/
server/dist/
*.tsbuildinfo

# npm cache is kept workspace-local because the agent sandbox cannot write $HOME (.npmrc)
.npm-cache/

# .NET tooling (kept inside the workspace per plan decision D18)
tools/bin/
tools/.obj/
tools/.artifacts/
tools/.nuget/

# Playwright browsers (workspace-local per plan decision D23)
tools/.playwright-browsers/
test-results/
playwright-report/

# Evidence artifacts are committed selectively under Docs/evidence/; scratch stays out
*.log
