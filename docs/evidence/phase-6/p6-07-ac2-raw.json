{"quest":{"quest_name":"DS-LIB2-C02-003","quest_id":126215,"has_definition":true,"link_kind":"none","title":"Application Procedures","title_source":"none","inference_basis":null},"text_rows":[{"key":"WizQst1ED07_00000000","value":"To defeat Rydall the Indomitable, you need to go speak with Mavra Flamewing. Then return to me once you've defeated Rydall.","category":"WizQst1ED07","used_by_this_file":false,"field":null},{"key":"WizQst1ED07_00000001","value":"These statues represent Dragonspyre's greatest foes. Like a whetstone to a blade, they sharpened the skills of the warriors of Dragonspyre. We honor them with combat. ","category":"WizQst1ED07","used_by_this_file":false,"field":null},{"key":"WizQst1ED07_00000002","value":"You must first defeat the grand champion of Rydall the Indomitable. He conquered the Duchy of Sebastien and forced the Duke into rebellion. Rydall's champion made it possible.","category":"WizQst1ED07","used_by_this_file":false,"field":null},{"key":"WizQst1ED07_00000003","value":"You're no match for him yet, though. You need to learn his way of combat, and for that you'll need to go speak to Mavra Flamewing.","category":"WizQst1ED07","used_by_this_file":false,"field":null},{"key":"WizQst1ED07_00000004","value":"So you've come to learn the greatest of arts: the Art of War?","category":"WizQst1ED07","used_by_this_file":true,"field":"m_goals[0].m_dialogList.m_dialogs[0].m_dialogEntries[0].m_dialog"},{"key":"WizQst1ED07_00000006","value":"Dragonspyre|Plaza of Conquests","category":"WizQst1ED07","used_by_this_file":true,"field":"m_goals[0].m_locationName"}],"goal_gates":[],"dialogue":[{"index":0,"field":"m_goals[0].m_dialogList.m_dialogs[0].m_dialogEntries[0]","dialog_key":"WizQst1ED07_00000004","own_table":true,"text":"So you've come to learn the greatest of arts: the Art of War?","speaker":{"persona":"DS-LIB2-NPC05_Warrior5_Persona","override_key":null,"st_key":"NPCFormats_First_Last","name":"DS-LIB2-NPC05_Warrior5_Persona","source":"raw"},"portrait":"GUI/NpcPortraits/Art_Portrait_F_warrior_skirt_1_Ghost_NPC.dds","sound":"|Sound_Dialogue_DS|WorldData|Sound/Dialogue/MavraFlamewing_QST_01.mp3","camera_name":"LOCATION"},{"index":1,"field":"m_dialogList.m_dialogs[0].m_dialogEntries[0]","dialog_key":"WizQst1ED05_00000002","own_table":false,"text":"Yes, I'm the Stone Keeper. You know what that means? It means I am responsible for keeping the Portal Stones out of the hands of our enemies.","speaker":{"persona":"DS-LIB2-NPC02_Persona","override_key":null,"st_key":"NPCFormats_First_Last","name":"Laszlo Starblade","source":"template"},"portrait":"GUI/NpcPortraits/Art_Portrait_M_wizard_military_1_Ghost_NPC.dds","sound":"|Sound_Dialogue_DS|WorldData|Sound/Dialogue/LaszloStarblade_QST_04.mp3","camera_name":"LOCATION"},{"index":2,"field":"m_dialogList.m_dialogs[0].m_dialogEntries[1]","dialog_key":"WizQst1ED05_00000003","own_table":false,"text":"You might have recommendations from all manner of dignitaries, but mere words are not enough to convince me. I'll need more to go on before I give you a Portal Stone.","speaker":{"persona":"DS-LIB2-NPC02_Persona","override_key":null,"st_key":"NPCFormats_First_Last","name":"Laszlo Starblade","source":"template"},"portrait":"GUI/NpcPortraits/Art_Portrait_M_wizard_military_1_Ghost_NPC.dds","sound":"|Sound_Dialogue_DS|WorldData|Sound/Dialogue/LaszloStarblade_QST_05.mp3","camera_name":null},{"index":3,"field":"m_dialogList.m_dialogs[0].m_dialogEntries[2]","dialog_key":"WizQst1ED05_00000004","own_table":false,"text":"We have a long and distinguished history here in Dragonspyre, and can't let any riff-raff get access to our Academy. You must demonstrate your worthiness.","speaker":{"persona":"DS-LIB2-NPC02_Persona","override_key":null,"st_key":"NPCFormats_First_Last","name":"Laszlo Starblade","source":"template"},"portrait":"GUI/NpcPortraits/Art_Portrait_M_wizard_military_1_Ghost_NPC.dds","sound":"|Sound_Dialogue_DS|WorldData|Sound/Dialogue/LaszloStarblade_QST_06.mp3","camera_name":null},{"index":4,"field":"m_dialogList.m_dialogs[0].m_dialogEntries[3]","dialog_key":"WizQst1ED05_00000005","own_table":false,"text":"Go speak with Zanna Fireflower elsewhere in the Plaza of Conquests. If she gives you a recommendation, we'll speak more.","speaker":{"persona":"DS-LIB2-NPC02_Persona","override_key":null,"st_key":"NPCFormats_First_Last","name":"Laszlo Starblade","source":"template"},"portrait":"GUI/NpcPortraits/Art_Portrait_M_wizard_military_1_Ghost_NPC.dds","sound":"|Sound_Dialogue_DS|WorldData|Sound/Dialogue/LaszloStarblade_QST_07.mp3","camera_name":null}],"references":[{"field":"m_goals[0].m_destinationZone","value":"DragonSpire/DS_A1_Knowledge/DS_A1Z2_ConquestPlaza","key":"m_destinationZone","sources":["zones"],"kind":"zones","resolved":{"label":"Dragon Spire / DS A1 Knowledge / DS A1Z2 Conquest Plaza","display":"Dragon Spire / DS A1 Knowledge / DS A1Z2 Conquest Plaza (DragonSpire/DS_A1_Knowledge/DS_A1Z2_ConquestPlaza)"}},{"field":"m_goals[0].m_dialogList.m_dialogs[0].m_dialogEntries[0].m_actorTemplateID","value":126301,"key":"m_actorTemplateID","sources":["npcs"],"kind":"npcs","resolved":{"label":"Mavra Flamewing","display":"Mavra Flamewing (126301)"}},{"field":"m_goals[0].m_dialogList.m_dialogs[0].m_dialogEntries[0].m_cameraZoneName","value":"DragonSpire/DS_A1_Knowledge/DS_A1Z2_ConquestPlaza","key":"m_cameraZoneName","sources":["zones"],"kind":"zones","resolved":{"label":"Dragon Spire / DS A1 Knowledge / DS A1Z2 Conquest Plaza","display":"Dragon Spire / DS A1 Knowledge / DS A1Z2 Conquest Plaza (DragonSpire/DS_A1_Knowledge/DS_A1Z2_ConquestPlaza)"}},{"field":"m_endResults.m_results[0].m_tableName","value":"DS-LIB2-C02-003","key":"m_tableName","sources":["drop_tables"],"kind":"drop_tables","resolved":{"label":"DS-LIB2-C02-003","display":"DS-LIB2-C02-003"}},{"field":"m_requirements.m_requirements[0].m_questName","value":"DS-LIB2-C04-002","key":"m_questName","sources":["quests"],"kind":"quests","resolved":{"label":"Stone Soup","display":"Stone Soup (DS-LIB2-C